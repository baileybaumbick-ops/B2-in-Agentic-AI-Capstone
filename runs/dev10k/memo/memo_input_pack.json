  "issues": [
    {
      "coherence": "high",
      "description": "Users complain that essential playback controls and song choice are restricted to premium, making the free tier unusable for desired behavior.",
      "examples": [
        {
          "quote": "It's really sad that this is how low Spotify has come to, imagine being denied to play a song for your choice that is what this app was meant for.",
          "review_id": "628ffdd2-7107-4617-84f6-63140c6ee91c"
        },
        {
          "quote": "Hi I'm clearly saying the update is not good you have removed the repeating button of songs and puted it into premium and all changes are not good and you didn't even remove the ads atleast remove ads I think you were earning money from ads",
          "review_id": "a581ecb8-d021-4b0b-b5f2-f3f3b79e6ccd"
        },
        {
          "quote": "Every single feature now requires you to purchase premium.",
          "review_id": "f36cd96b-90da-4fd9-95b3-0ef85c3a7896"
        }
      ],
      "issue_id": "billing.free_tier_restrictions",
      "name": "Free tier locked behind premium features"
    },
    {
      "coherence": "high",
      "description": "Short, non-specific negative comments saying the app is bad or worse after updates without detailing a particular feature.",
      "examples": [
        {
          "quote": "Went from being best to being worst , probably all the good things about this app is gone .",
          "review_id": "f1e3825e-dbac-45b8-8879-b848dfd97208"
        },
        {
          "quote": "Worst App",
          "review_id": "5b56249c-8424-4dc5-998e-22cb62391f99"
        },
        {
          "quote": "Gold Digger app How rude one service could get to earn money",
          "review_id": "6834a55e-cd95-4928-8f54-5dd0abfa1114"
        }
      ],
      "issue_id": "other.general_negative",
      "name": "Generic negative app complaints"
    },
    {
      "coherence": "high",
      "description": "Users complain about excessive, frequent, or unwanted ads interrupting listening and about ads not matching expectations.",
      "examples": [
        {
          "quote": "always needed subscription to listen songs cheerfully. ads are very annoying",
          "review_id": "74d4c820-f915-406e-bfec-e837d2e4796f"
        },
        {
          "quote": "Why would I pay for premium when they flat out lie about the ads and 30 minutes of ad free music?",
          "review_id": "28f6a14f-9a2c-4259-a3b0-1978e0ee238e"
        },
        {
          "quote": "3 ads between every song.. just greedy now",
          "review_id": "c681115e-2974-4c3b-9761-ff0ba9885962"
        }
      ],
      "issue_id": "usability.ads",
      "name": "Too many or intrusive ads"
    },
    {
      "coherence": "high",
      "description": "Users describe songs or podcasts not playing, playing the wrong track, stuttering/offline playback issues, or playback stopping unexpectedly.",
      "examples": [
        {
          "quote": "Its takes a lot of time to load and even more to play a song and the offline playback is the worst, its choppy, stutters when the screen is off, its like I'm playing it on old cd player with strached cd.",
          "review_id": "8c7f9941-a051-4035-8390-26b8e4394c79"
        },
        {
          "quote": "Player doesn't remember the time i left off at while listening to podcasts, seems like every update breaks a major component of this app...",
          "review_id": "2ea716b0-f612-4e84-acae-036285b9096d"
        },
        {
          "quote": "Sometimes the app does have problems like the song doesn't play or glitches but it is fine too.",
          "review_id": "8a29017b-f23a-4dc4-af6d-96633fa8ecf1"
        }
      ],
      "issue_id": "playback.stops_or_skips",
      "name": "Playback stops, wrong tracks, or won't play"
    },
    {
      "coherence": "mixed",
      "description": "Users describe the app crashing, freezing, showing a black/loading screen, or becoming unusable on particular devices.",
      "examples": [
        {
          "quote": "It's was fine at first but now it doesn't even load like it'll stay in the spotofy logo loading scrn",
          "review_id": "d82ed282-7b5e-4f97-b099-445d4834b4eb"
        },
        {
          "quote": "Why i can't play my Spotify?? When i try to play, it will auto close.. try to log in back, still not working.. also reinstall, also not working... Can u guys fix the problem... 🥺",
          "review_id": "a648d7d7-06b3-441b-89f2-fc6afecc3b07"
        },
        {
          "quote": "When you exit the App it doesn't go away, every time my phone or tablet comes on Spotify starts playing whether I want it to or not",
          "review_id": "a6052686-b8b3-4bd4-bc3e-0c09616a2d11"
        }
      ],
      "issue_id": "playback.crash_or_freeze",
      "name": "Crashes, freezes, and app not opening"
    },
    {
      "coherence": "high",
      "description": "Users say their chosen playlists or albums are being interrupted by suggested or random songs, unwanted additions, or poor playlist management.",
