  "issues": [
    {
      "coherence": "high",
      "description": "Users complain free accounts are forced into shuffle, have skip/repeat limits, and are blocked from picking or replaying songs without premium.",
      "examples": [
        {
          "quote": "This new update is not good because I don't agree to to auto shuffle and I want in order in free.",
          "review_id": "af53cf35-c680-4ccb-b30c-cfd85bb61c57"
        },
        {
          "quote": "Eyy fodey, charge me for breathing also. You mad or something? Now I need premium to repeat and skip the song to a certain part.",
          "review_id": "61e0ddbb-6ec4-4d3a-acd3-41eb5f64afb7"
        },
        {
          "quote": "I am not like now they are so much charges to listen music or replay again the music there is a charger so that's why I don't like it this app now 😕",
          "review_id": "58511d69-67c2-4432-84d8-f3c556592f2b"
        }
      ],
      "issue_id": "billing.free_tier_restrictions",
      "name": "Free tier forced shuffle and limits"
    },
    {
      "coherence": "high",
      "description": "Users express broad dissatisfaction or say the app is bad or worse after updates without citing a specific feature.",
      "examples": [
        {
          "quote": "After the update the app is very irritating! Spotify has removed all the basic features for which we used to love this app. It used be my favourite app.. This is ridiculous!",
          "review_id": "adc4c3e4-3717-4888-ad86-c9381c224d2f"
        },
        {
          "quote": "No good",
          "review_id": "5fb51bd0-dbe9-4a19-a466-a77f0c14393e"
        },
        {
          "quote": "Useless app",
          "review_id": "36f1617b-e4f7-44fb-a7a9-a8236e4c3531"
        }
      ],
      "issue_id": "other.general_negative",
      "name": "Generic negative feedback about app"
    },
    {
      "coherence": "high",
      "description": "Users complain about too many, long, or intrusive ads interrupting music listening and making the app unusable without premium.",
